import pytest
from hypothesis import given, strategies as st
from practice4 import add, divide

def test_add():
    assert add(2, 3) == 5

def test_divide():
    assert divide(10, 2) == 5

def test_zero():
    with pytest.raises(ValueError):
        divide(5, 0)

@given(st.integers(), st.integers())
def test_add_property(a, b):
    assert add(a, b) == a + b
