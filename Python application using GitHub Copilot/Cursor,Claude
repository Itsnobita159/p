### Test Code

```python
def test_add():
    students.clear()
    add_student(101, "Ravi", 85)
    assert find_student(101)["name"] == "Ravi"

def test_missing():
    students.clear()
    assert find_student(999) is None

def test_average():
    students.clear()
    add_student(101, "Ravi", 80)
    add_student(102, "Kiran", 90)
    assert average_marks() == 85
```

