```python
# student_app.py

students = {}

def add_student(student_id: int, name: str, marks: float) -> None:
    students[student_id] = {"name": name, "marks": marks}

def find_student(student_id: int):
    return students.get(student_id)

def average_marks() -> float:
    if not students:
        return 0.0
    return sum(s["marks"] for s in students.values()) / len(students)


add_student(101, "Ravi", 85)
add_student(102, "Kiran", 90)

print("Student:", find_student(101))
print("Average:", average_marks())
```

### Specification

```text
1. Store student ID, name and marks.
2. Add a student.
3. Search student by ID.
4. Calculate average marks.
5. Return None for an invalid ID.
6. Handle an empty student list.
```

